# kitty's cursor-trail-blaze in Ember. Colours are linear RGB. Vendored because
# nixpkgs kitty 0.49 ships no .pipeline files.
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    # accent #e08060
    var float4 TRAIL_COLOR = float4(0.745, 0.216, 0.117, 1.0)
    # steel (magma) #ef7f38
    var float4 TRAIL_COLOR_ACCENT = float4(0.863, 0.212, 0.040, 1.0)
    shaders cursor-trail-blaze
endgroup
