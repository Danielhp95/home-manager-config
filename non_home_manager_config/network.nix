{ pkgs, ... }:
{
  # Not defaultPackages: assigning that drops perl/rsync/strace.
  environment.systemPackages = with pkgs; [
    impala # iwd TUI
    iwgtk # iwd GUI
  ];

  # connman rfkill-blocks every technology saved as disabled, at each boot;
  # `rfkill unblock` doesn't persist, `connmanctl disable/enable <tech>` does.
  services.connman.enable = true;
  services.connman.wifi.backend = "iwd";
  networking.wireless.iwd.enable = true;

  # No DNS proxy: connman's caching resolver drops replies ("Bad file
  # descriptor") and is a redundant hop under tailscale. connman then writes
  # the router's nameservers, which tailscale reads as its upstream.
  services.connman.extraFlags = [ "--nodnsproxy" ];

  # Don't "fix" connmand's "Cannot create /var/run/connman/resolv.conf" boot
  # message with a RuntimeDirectory: its fallback write to /etc/resolv.conf is
  # how tailscaled (direct mode) learns the upstream resolver.

  # Keeps openresolv off tailscaled's PATH so it uses direct mode: openresolv
  # rejects the resolv.conf connman writes (no "Generated by resolvconf"
  # signature), which broke every DNS push.
  networking.resolvconf.enable = false;

  services.openssh.enable = true;

  # mDNS / `.local` resolution.
  services.avahi = {
    enable = true;
    nssmdns4 = true;
    openFirewall = true;
  };

  # No networking.useDHCP: connman does DHCP itself, and its module asserts
  # useDHCP is false.
}
